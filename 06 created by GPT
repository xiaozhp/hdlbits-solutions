
module top_module(
    input clk,
    input in,
    input reset,
    output done,
    output [7:0] out_byte
);

    localparam [2:0] IDLE    = 3'b000,
                     START   = 3'b001,
                     RECEIVE = 3'b010,
                     WAIT    = 3'b011,
                     STOP    = 3'b100;

    reg [2:0] state, next;
    reg [3:0] i;
    reg [7:0] data;

    // State transition logic
    always @(*) begin
        case(state)
            IDLE:    next = in ? IDLE : START;
            START:   next = RECEIVE;

            RECEIVE: begin
                if(i == 4'd7)
                    next = in ? STOP : WAIT;
                else
                    next = RECEIVE;
            end

            WAIT:    next = in ? IDLE : WAIT;
            STOP:    next = in ? IDLE : START;

            default: next = IDLE;
        endcase
    end

    // Sequential logic
    always @(posedge clk) begin
        if(reset) begin
            state <= IDLE;
            i <= 0;
            data <= 0;
        end
        else begin
            state <= next;

            case(state)
                IDLE: begin
                    i <= 0;
                end

                START: begin
                    data[0] <= in;
                    i <= 0;
                end

                RECEIVE: begin
                    if(i < 7) begin
                        data[i+1] <= in;
                        i <= i + 1'b1;
                    end
                    else begin
                        i <= 0;
                    end
                end

                default: begin
                    i <= 0;
                end
            endcase
        end
    end

    // Output logic
    assign done = (state == STOP);
    assign out_byte = data;

endmodule
